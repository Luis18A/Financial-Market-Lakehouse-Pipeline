# ==============================================================================
# Variables de Entorno - Financial Market Lakehouse Pipeline
# ==============================================================================

# API Externa - Alpha Vantage (Registrarse gratis en https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=tu_api_key_aqui

# ------------------------------------------------------------------------------
# MinIO (Object Storage compatible con S3)
# ------------------------------------------------------------------------------
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Buckets del Lakehouse
BUCKET_BRONZE=bronze
BUCKET_SILVER=silver
BUCKET_GOLD=gold

# ------------------------------------------------------------------------------
# PostgreSQL (Base de datos interna para Airflow y DW Analítico para dbt)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432
AIRFLOW_DB=airflow
WAREHOUSE_DB=financial_dw

# ------------------------------------------------------------------------------
# Apache Airflow
# ------------------------------------------------------------------------------
AIRFLOW_IMAGE=apache/airflow:2.8.1-python3.11
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# ------------------------------------------------------------------------------
# Apache Spark
# ------------------------------------------------------------------------------
SPARK_IMAGE=bitnami/spark:3.5.0
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
SPARK_WORKER_WEBUI_PORT=8082
SPARK_WORKER_MEMORY=1G
SPARK_WORKER_CORES=1
